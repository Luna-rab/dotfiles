# 最初にすべての階層のファイルを無視
# 階層は必要なだけ追加する
### all ignore ###
/*
/.**

### not ignore ###
!/.zshrc
!/.gitignore_global
!/.gitconfig_shared

# sheldon (zsh plugin manager) config
!/sheldon
!/sheldon/**

# Claude Code config (portable). 実体のローカル設定はコミットしない
!/.claude
!/.claude/**

!install.sh
!/README.md
!.gitignore
!.gitkeep
