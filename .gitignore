# 最初にすべての階層のファイルを無視
# 階層は必要なだけ追加する
### all ignore ###
/*
/.**

### not ignore ###
!/.zshrc
!/.gitignore_global
!/.gitconfig_shared

# mise (tool version manager) config
!/mise
!/mise/**

# sheldon (zsh plugin manager) config
!/sheldon
!/sheldon/**

# Claude Code config (portable). 実体のローカル設定はコミットしない
!/.claude
!/.claude/**

# GitHub Actions のワークフロー
!/.github
!/.github/**

# 監督者ワークフローの台帳とベース資料（docs/supervisor/）
!/docs
!/docs/**

!install.sh
!/README.md
!.gitignore
!.gitkeep
