# 最初にすべての階層のファイルを無視
# 階層は必要なだけ追加する
### all ignore ###
/*
/.**

### not ignore ###
!/.zshrc
!/.gitignore_global
!/.gitconfig_shared

# mise (tool version manager) config
!/mise
!/mise/**

# sheldon (zsh plugin manager) config
!/sheldon
!/sheldon/**

# Claude Code config (portable). 実体のローカル設定はコミットしない
!/.claude
!/.claude/**

# .claude/** で復活させた許可を上書きし、Python のバイトコード生成物だけ再び無視する。
# `python3 -m py_compile <ファイル>` や `.claude/scripts/check-skills.py` の実行で
# .claude/scripts/__pycache__/ や .claude/skills/team-supervisor/scripts/__pycache__/ に
# .pyc が生成されるが、ソースの副産物であり追跡する意味が無い。
/.claude/**/__pycache__/
/.claude/**/*.pyc

# GitHub Actions のワークフロー
!/.github
!/.github/**

# 監督者ワークフローの台帳とベース資料（docs/supervisor/）
!/docs
!/docs/**

!install.sh
!/README.md
!.gitignore
!.gitkeep
